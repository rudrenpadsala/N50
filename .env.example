# Live Market page configuration (OPTIONAL).
#
# This project does not ship with a live market-data provider
# connected (see src/market/live_data.py's module docstring for why).
# If you leave these blank/unset, the "Live Market" page will
# correctly and honestly show "Live market data unavailable" and fall
# back to the latest available historical price - this is expected,
# safe default behavior, not an error.
#
# To connect a real provider:
#   1. Copy this file to ".env" (or set these as real environment
#      variables another way) - NEVER commit a real ".env" file or a
#      real API key to source control.
#   2. Fill in MARKET_API_KEY with your provider's key.
#   3. Fill in MARKET_API_URL with your provider's quote endpoint as a
#      template string. It must contain {symbol}, and {api_key} if
#      your provider takes the key as a query parameter, e.g.:
#        MARKET_API_URL=https://api.example.com/v1/quote?symbol={symbol}&apikey={api_key}
#   4. Set MARKET_API_PRICE_FIELD to the dot-path of the current price
#      inside the JSON response your provider returns, e.g. "price" or
#      "quote.last".
#   5. If your provider needs an exchange suffix on the ticker (e.g.
#      Yahoo-style "RELIANCE.NS"), set MARKET_API_SYMBOL_SUFFIX=".NS".
#
# NOTE: this project's company codes (RELI, ADELc1_NS, etc. - see
# src/data/company_map.py) are internal identifiers from Sprint 1's
# data pipeline, not real-world exchange ticker symbols. {symbol} (and
# the equivalent {ticker}) in MARKET_API_URL are automatically
# resolved to the real plain NSE ticker (e.g. "RELIANCE", not "RELI")
# via src/market/nse_symbol_map.py before the request is made - you do
# not need to do this translation yourself, and you should NOT send
# the raw internal code to your provider (most codes are NOT the real
# ticker; only 3 of this project's 50 codes coincidentally are, which
# previously made it look like "some stocks show a live price and
# others don't" - see nse_symbol_map.py's docstring).

MARKET_API_KEY=your_api_key_here
MARKET_API_URL=
MARKET_API_PRICE_FIELD=price
MARKET_API_SYMBOL_SUFFIX=

# -----------------------------------------------------------------------
# Angel One (SmartAPI) provider (OPTIONAL - an alternative to the generic
# provider above). See docs/ANGELONE_SETUP.md for the full step-by-step
# setup guide, and src/market/angelone_symbol_map.py before trusting any
# price for a real BUY/SELL decision.
#
# Set MARKET_PROVIDER=angelone to use this explicitly. If left blank but
# ANGELONE_API_KEY is set, Angel One is used automatically.
# -----------------------------------------------------------------------

MARKET_PROVIDER=

# From https://smartapi.angelone.in -> "Create an app" (choose "Market Data" or "Trading APIs")
ANGELONE_API_KEY=

# Your Angel One client ID (e.g. "A123456"), same one you use to log in
# to the Angel One app/website.
ANGELONE_CLIENT_CODE=

# Your Angel One trading PIN (NOT your web-login password - Angel One's
# API login only accepts the PIN).
ANGELONE_PASSWORD=

# The base32 TOTP SECRET behind the QR code (not a rotating 6-digit
# code). Obtain it once at https://smartapi.angelbroking.com/enable-totp
# - most authenticator apps show/export this secret when you add the
# account, or you can extract it from the QR code's otpauth:// URL.
ANGELONE_TOTP_SECRET=

# Optional - only needed if Angel One ever rejects requests over the
# placeholder header values this project uses by default.
ANGELONE_CLIENT_LOCAL_IP=
ANGELONE_CLIENT_PUBLIC_IP=
ANGELONE_MAC_ADDRESS=

# -----------------------------------------------------------------------
# News & Risk Layer (OPTIONAL - a separate layer on top of the RL
# decision, see src/news/ and src/risk/). Get a free key at
# https://newsapi.org/register (personal/research tier). Without this,
# the dashboard clearly shows "News data unavailable" rather than
# guessing sentiment - the RL decision itself is unaffected either way.
# -----------------------------------------------------------------------

NEWS_API_KEY=